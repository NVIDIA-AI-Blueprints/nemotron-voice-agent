        ["R1", "created queued"],
        ["R1", "queued"],
        ["R1", "in_progress"],
        ["R1", "message commentary"],
        ["R1", "mcp_call.in_progress"],
        ["R1", "mcp_call.completed"],
        ["R1", "mcp_call cafe/get_menu completed"],
        ["R1", "message final_answer"],
        ["R1", "completed"]
      ],
      "reader": {"results": {"D1": 1}, "progress": {"D1": 1}, "steps": {"D1": 1}, "endings": {"D1": "answered"}}
    },
    "waits_for_the_app_then_answers": {
