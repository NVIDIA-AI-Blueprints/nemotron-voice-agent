    "handed_over_with_the_taker_named": {
      "about": "A newer request steers into the running Work. When it lands, the taker goes in_progress naming the older response, then the older one gets the handover line and completed (order, not text, tells a handover).",
      "responses": {"R1": "D1", "R2": "D2"},
      "timeline": [
        ["R1", "created queued"],
        ["R1", "queued"],
        ["R1", "in_progress"],
        ["R2", "created queued"],
        ["R2", "queued"],
        ["R2", "in_progress previous=R1"],
        ["R1", "message commentary [handover_line]"],
        ["R1", "completed"],
        ["R2", "message final_answer"],
        ["R2", "completed"]
      ],
      "reader": {"results": {"D2": 1}, "endings": {"D1": "handed_over", "D2": "answered"}, "takers": {"D1": "D2"}}
    },
