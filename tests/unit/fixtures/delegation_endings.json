{
  "about": "The endings of a delegation on the wire (alignment plan L0.5, \u00a72.0(f)): each scenario's official events in the order the IM writes them, as tests/unit/contracts/endings.py normalizes them (type, status, phase, item type, terminal; ids as labels; [key] names the texts line a message carries). The IM lane makes the IM write each one; the reader lane replays each one and checks the reader's outcome.",
  "scenarios": {
    "answered": {
      "about": "One request, one task, one answer.",
      "responses": {"R1": "D1"},
      "timeline": [
        ["R1", "created queued"],
        ["R1", "queued"],
        ["R1", "in_progress"],
        ["R1", "message final_answer"],
        ["R1", "completed"]
      ],
      "reader": {"results": {"D1": 1}, "endings": {"D1": "answered"}}
    },
    "answered_with_progress_and_tool_items": {
      "about": "Commentary beside a backend-run tool (an mcp_call item, server label of its tool source), then the answer.",
