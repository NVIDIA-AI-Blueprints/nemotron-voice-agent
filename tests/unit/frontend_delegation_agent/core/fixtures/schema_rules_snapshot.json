{
  "airline": {
    "rules": [
      {
        "tool": "get_reservation_details",
        "argument": "reservation_id",
        "label": "reservation ID",
        "format_hint": "code",
        "strip": " .-",
        "collapse_separators": "",
        "case": "upper",
        "restore_prefix": "",
        "keep_pattern": "^[A-Z0-9]+$",
        "pattern": "^.+$"
      },
      {
        "tool": "get_user_details",
        "argument": "user_id",
        "label": "user ID",
        "format_hint": "name_name_digits",
        "strip": " .-",
        "collapse_separators": "_",
        "case": "lower",
        "restore_prefix": "",
        "keep_pattern": "^[a-z]+_[a-z]+_\\d+$",
        "pattern": "^[^_]+(?:_[^_]+){1,}_[^_]*\\d[^_]*$"
      }
    ],
    "complete_patterns": [
      "^[A-Z0-9]{6}$"
    ],
    "read_tools": [
      "calculate",
      "get_reservation_details",
      "get_user_details",
      "list_all_airports",
      "search_direct_flight",
      "search_onestop_flight",
      "get_flight_status"
    ],
    "phone_arguments": [],
    "format_retry_arguments": [],
    "read_only_tools": []
  },
