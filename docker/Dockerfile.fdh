# The Hermes image of the Frontend Delegation Hermes example (src/examples/frontend_delegation_hermes):
# the FDH gateway and its Hermes workers, in one Python 3.14 venv (Hermes needs Python 3.14; the
# repository's app image is Python 3.12). The voice side runs in the shared app image. Compose builds
# it through the `fdh-hermes-image` service, which passes the Hermes checkout (HERMES_AGENT_DIR) as the
# named build context "hermes"; docker/fdh/gateway.sh starts the gateway on port 8790.
#
# The locked package set (docker/fdh/requirements.txt) is unchanged from the image that also ran the
# voice side, so Hermes runs with exactly the same packages.

# Base image - OSRB approved Ubuntu base (Bug 4960044)
FROM nvcr.io/nvidia/base/ubuntu:noble-20260610

LABEL maintainer="NVIDIA"
LABEL description="Nemotron Voice Agent - Frontend Delegation Hermes example"

ENV PYTHONUNBUFFERED=1 \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_LINK_MODE=copy \
    PATH=/app/.venv/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Pinned: the uv pip check filter below matches this version's message format.
COPY --from=ghcr.io/astral-sh/uv:0.12.3 /uv /usr/local/bin/uv

WORKDIR /app

RUN mkdir -p /app/legal
COPY LICENSE /app/legal/LICENSE
COPY THIRD_PARTY_NOTICES.txt /app/legal/THIRD_PARTY_NOTICES.txt

RUN uv python install 3.14.7 && uv venv --python 3.14.7 /app/.venv

# The exact locked set, without resolving again (no override needed at install time).
COPY docker/fdh/requirements.txt /app/docker/fdh/requirements.txt
RUN uv pip sync --python /app/.venv/bin/python --require-hashes /app/docker/fdh/requirements.txt

# Hermes refuses wheel builds; install the checkout editable, after sync (sync removes unlisted packages).
COPY --from=hermes . /opt/hermes
RUN uv pip install --python /app/.venv/bin/python --no-deps -e /opt/hermes

COPY src/ src/
COPY --chmod=755 docker/fdh/gateway.sh /app/gateway.sh
# Which source this image runs: compare with the same command on the checkout (the deploy guide).
RUN cd /app && find src -type f ! -path '*/__pycache__/*' -print0 | LC_ALL=C sort -z | xargs -0 sha256sum \
    | sha256sum | cut -d' ' -f1 > /app/SOURCE_SHA256 && cat /app/SOURCE_SHA256

# Build-time smoke, one RUN each so one failure cannot hide another.
RUN cd /app && PYTHONPATH=/app/src python -c "import examples.frontend_delegation_hermes.core.sidecar.gateway_server, examples.frontend_delegation_hermes.core.worker.worker_main"
RUN cd /tmp && HERMES_HOME=/tmp/hsmoke python -I -c "import run_agent" && rm -rf /tmp/hsmoke
RUN set -e; \
    known='The package `nvidia-riva-client` requires `protobuf==6.33.5`, but `6.33.6` is installed'; \
    out=$(uv pip check --python /app/.venv/bin/python 2>&1) || true; \
    printf '%s\n' "$out"; \
    printf '%s\n' "$out" | grep -qxF "$known"; \
    bad=$(printf '%s\n' "$out" | grep '^The package' | grep -vxF "$known" || true); \
    [ -z "$bad" ]

EXPOSE 8790

ENTRYPOINT ["/app/gateway.sh"]
