+    """Validate the ``chat_completion_options`` session extension and drop nulls.
+
+    Realtime sessions have no sampling or chat template fields, so this carries
+    them to every chat completion request the session renders, prefill included.
+    """
+    if value is None:
+        return {}
+    if not isinstance(value, dict):
+        raise ValueError("chat_completion_options must be an object")
+    options = {}
+    for key, option in value.items():
+        kind = CHAT_COMPLETION_OPTIONS.get(key)
+        if kind is None:
+            raise ValueError(f"chat_completion_options.{key} is not supported")
+        if option is None:
+            continue
+        if kind is dict:
+            valid = isinstance(option, dict)
+        else:
+            valid = not isinstance(option, bool) and isinstance(
+                option, int if kind is int else (int, float)
+            )
+        if not valid:
+            raise ValueError(
+                f"chat_completion_options.{key} must be {_JSON_TYPES[kind]}"
+            )
+        options[key] = option
+    return options
+
+
+def _chat_tool_options(options: dict[str, Any]) -> dict[str, Any]:
+    """Map Realtime tool options to chat completion tool fields."""
+    tools = options.get("tools") or []
+    tool_choice = options.get("tool_choice")
+    if not tools:
+        if tool_choice in (None, "auto", "none"):
+            return {}
+        raise ValueError("tool_choice requires tools")
+    if isinstance(tool_choice, dict) and tool_choice["name"] not in {
+        tool["name"] for tool in tools
+    }:
+        raise ValueError(
+            f"tool_choice function {tool_choice['name']!r} is not in tools"
+        )
+    chat: dict[str, Any] = {
+        "tools": [
+            {
+                "type": "function",
+                "function": {
+                    key: tool[key]
+                    for key in ("name", "description", "parameters")
+                    if key in tool
+                },
+            }
+            for tool in tools
+        ]
+    }
+    if isinstance(tool_choice, dict):
+        chat["tool_choice"] = {
+            "type": "function",
+            "function": {"name": tool_choice["name"]},
+        }
+    elif tool_choice is not None:
+        chat["tool_choice"] = tool_choice
+    if options.get("parallel_tool_calls") is not None:
+        chat["parallel_tool_calls"] = options["parallel_tool_calls"]
+    return chat
+
