# The `fdh-hermes` controller of the OpenShell runtime (docker/fdh/openshell/controller.sh): the pinned
# `openshell` CLI plus curl, jq and bash. OpenShell ships no CLI image, and its prerelease tags publish the
# CLI only as GitHub Actions artifacts (they expire and need a GitHub login), so the CLI is built from the
# pinned commit. The tag and commit come from docker/fdh/openshell/VERSION, through the Compose build args
# (tests/unit/frontend_delegation_hermes/test_fdh_openshell_pins.py checks they match).

ARG RUST_IMAGE=rust:1.95.0-bookworm@sha256:6258907abe69656e41cd992e0b705cdcfabcbbe3db374f92ed2d47121282d4a1

FROM ${RUST_IMAGE} AS build
ARG OPENSHELL_VERSION
ARG OPENSHELL_COMMIT
RUN apt-get update && apt-get install -y --no-install-recommends cmake git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
# The commit is the pin: the build fails if the tag no longer points at it.
RUN : "${OPENSHELL_VERSION:?}" "${OPENSHELL_COMMIT:?}" \
    && git clone --depth 1 --branch "${OPENSHELL_VERSION}" https://github.com/NVIDIA/OpenShell.git . \
    && test "$(git rev-parse HEAD)" = "${OPENSHELL_COMMIT}"
# Dependencies exactly as in the commit's Cargo.lock. Then stamp the release version, as OpenShell's release
# build does (tasks/scripts/stage-prebuilt-binaries.sh); that changes only the workspace's own lock entries,
# which `update --workspace --offline` rewrites without touching a dependency. The build is then --frozen.
RUN cargo fetch --locked
RUN sed -E '/^\[workspace\.package\]/,/^\[/{s/^version[[:space:]]*=[[:space:]]*".*"/version = "'"${OPENSHELL_VERSION#v}"'"/}' \
      -i Cargo.toml \
    && cargo update --workspace --offline \
    && cargo build --release --frozen -p openshell-cli \
    && ./target/release/openshell --version

# Base image - OSRB approved Ubuntu base (Bug 4960044), the same as docker/Dockerfile.fdh
FROM nvcr.io/nvidia/base/ubuntu:noble-20260610
LABEL description="Nemotron Voice Agent - FDH OpenShell controller"
RUN apt-get update && apt-get install -y --no-install-recommends bash ca-certificates curl jq \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/openshell /usr/local/bin/openshell
RUN openshell --version
