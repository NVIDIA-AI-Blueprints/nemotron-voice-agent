#
# Settings of the FDH gateway and its Hermes workers (the `fdh-hermes` service): exactly the gateway
# variables the former docker/docker-compose.frontend-delegation-hermes.yaml set, with its values.
# Every other gateway setting keeps the default of the selected config (config/gateway.yaml, or
# config/gateway.eval.yaml with the eval overlay): FDH_BACKEND_TRACE, FDH_WARM_WORKERS and
# FDH_AGENT_KIND are deliberately not set here, because their defaults differ by config.
#
# Plain KEY=value lines only: no ${...}, no quotes (tests/unit/frontend_delegation_hermes/test_fdh_compose.py).
# .env supplies only NVIDIA_API_KEY and FDH_PROMPT_PROFILE to this service, through the Compose file
# (its FDH_PROMPT_PROFILE value replaces the one below).
FDH_GATEWAY_CONFIG=gateway.yaml
FDH_PROMPT_PROFILE=generic
FDH_GATEWAY_MAX_SESSIONS=8
BACKEND_LLM_MODEL=nvidia/nvidia/nemotron-3-ultra
BACKEND_LLM_BASE_URL=https://inference-api.nvidia.com/v1
FDH_GATEWAY_LOG=logs/fdh_gateway_events.pipecat.jsonl
FDH_WORKER_LOG_DIR=logs/fdh_workers_pipecat
