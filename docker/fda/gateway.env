#
# Settings of the FDA gateway and its Hermes workers (the `fda-hermes` service): exactly the gateway
# variables the former docker/docker-compose.frontend-delegation-hermes.yaml set, with its values.
# Every other gateway setting keeps the default of the selected config (config/gateway.yaml, or
# config/gateway.eval.yaml with the eval overlay): FDA_BACKEND_TRACE, FDA_WARM_WORKERS and
# FDA_BACKEND are deliberately not set here, because their defaults differ by config (this service
# always runs Hermes; the LLM backend runs in the voice service, docker/docker-compose.fda-llm.yaml).
#
# Plain KEY=value lines only: no ${...}, no quotes (tests/unit/frontend_delegation_agent/test_fda_compose.py).
# .env supplies only NVIDIA_API_KEY and FDA_PROMPT_PROFILE to this service, through the Compose file
# (its FDA_PROMPT_PROFILE value replaces the one below).
FDA_GATEWAY_CONFIG=gateway.yaml
FDA_PROMPT_PROFILE=generic
FDA_GATEWAY_MAX_SESSIONS=8
BACKEND_LLM_MODEL=nvidia/nvidia/nemotron-3-ultra
BACKEND_LLM_BASE_URL=https://inference-api.nvidia.com/v1
FDA_GATEWAY_LOG=logs/fda_gateway_events.pipecat.jsonl
FDA_WORKER_LOG_DIR=logs/fda_workers_pipecat
