#
# Settings of the `fda-hermes` controller of the OpenShell runtime only. Kept out of
# docker/fda/gateway.env, which both runtimes share and whose keys the controller passes into the sandbox.
# Plain KEY=value lines only.
OPENSHELL_GATEWAY_ENDPOINT=http://hermes-openshell-gateway:8080
FDA_IMAGE=nemotron-voice-agent-fda:local
