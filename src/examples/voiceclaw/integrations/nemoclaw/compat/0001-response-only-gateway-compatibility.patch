+      await expect(within(turn, "settling the turn")).resolves.toEqual({
+        outcome: "failed",
+        reason: "agent_gateway_unavailable",
+      });
+      await within(
+        vi.waitFor(() => expect(connection.peer?.destroyed).toBe(true)),
+        "retiring the transport",
+      );
+    } finally {
+      connection.peer?.destroy();
+      await within(
+        new Promise<void>((resolve, reject) => {
+          server.close((error) => (error ? reject(error) : resolve()));
+        }),
+        "closing the fixture server",
+      );
+    }
+  });
