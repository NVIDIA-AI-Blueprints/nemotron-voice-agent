+function defaultWebSocketFactory(url: string): WebSocketLike {
+  // Keep the upgraded TCP socket because a WHATWG WebSocket exposes only a
+  // graceful close handshake. An older peer can leave that handshake in
+  // CLOSING forever, retaining one OpenShell forward slot per committed turn.
+  const endpoint = new URL(url);
+  endpoint.protocol = endpoint.protocol === "wss:" ? "https:" : "http:";
+  const connector = buildConnector({});
+  let transport: Socket | null = null;
+  let closed = false;
+  const dispatcher = new Client(endpoint.origin, {
+    connect(options, callback) {
+      connector(options, (...result) => {
+        const [, connected] = result;
+        if (connected !== null) {
+          if (closed) retireTransport(connected);
+          else transport = connected;
+        }
+        callback(...result);
+      });
+    },
+  });
+  const socket = new WebSocket(url, { dispatcher });
+  const wrapper: WebSocketLike = {
+    onopen: null,
+    onmessage: null,
+    onerror: null,
+    onclose: null,
+    send(data) {
+      socket.send(data);
+    },
+    close() {
+      if (closed) return;
+      closed = true;
+      const connected = transport;
+      transport = null;
+      if (connected !== null) retireTransport(connected);
+      try {
+        socket.close();
+      } finally {
+        void dispatcher.destroy().catch(() => undefined);
+      }
+    },
+  };
+  socket.onopen = () => wrapper.onopen?.();
+  socket.onmessage = (event) => wrapper.onmessage?.({ data: event.data });
+  socket.onerror = () => wrapper.onerror?.();
+  socket.onclose = () => wrapper.onclose?.();
+  return wrapper;
