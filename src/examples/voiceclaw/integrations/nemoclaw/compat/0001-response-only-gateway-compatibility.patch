+        idempotencyKey: "generated-turn-id",
+        message: "repository status",
+        onEvent: () => undefined,
+      });
+      await within(
+        Promise.race([
+          open,
+          turn.then((result) => {
+            throw new Error(`turn settled before opening: ${JSON.stringify(result)}`);
+          }),
+        ]),
+        "opening the WebSocket",
