# Keep secrets out of this Compose substitution file. The packaged developer
# YAML uses anonymous access only for an explicit loopback OpenShell endpoint.

# The unauthenticated developer facade is host-local by default. A controlled
# LAN demonstration also requires a copied YAML with listener_security: tls,
# auth_mode: ephemeral, an owner-controlled master-key reference, and mounted
# certificate/private-key files; changing this host alone intentionally fails.
VOICECLAW_SERVER_HOST=127.0.0.1

# Host YAML mounted read-only into the image. Copy the packaged YAML before
# changing frontend or backend profiles; you do not need to rebuild the image.
VOICECLAW_CONFIG_FILE_HOST=./src/voiceclaw/resources/voiceclaw.example.yaml

# Read-only operator files mounted at /run/voiceclaw/operator. Put a selected
# backend credential under secrets/, optional cert.pem/key.pem under tls/, and
# operator-owned model/interaction catalogs under catalogs/. Keep provider
# credential files owner-only (0600); facade credentials may be 0640 for
# VOICECLAW_FILE_GID. All contents are ignored by Git.
VOICECLAW_OPERATOR_FILES_HOST=./operator

# Host group that may read operator-owned provider credentials or TLS keys.
VOICECLAW_FILE_GID=1000

# Non-secret OpenShell service coordinates and target selection. Copy the exact
# `connection.gatewayEndpoint` URL and `connection.workspace` from NemoClaw's
# applied result plus the authored sandbox name. There are no safe
# deployment-independent defaults for these bindings.
VOICECLAW_OPENSHELL_ENDPOINT=
VOICECLAW_OPENSHELL_WORKSPACE=
VOICECLAW_OPENSHELL_SANDBOX=
VOICECLAW_FABRIC_ADAPTER_ID=nvidia.fabric.openclaw
VOICECLAW_FABRIC_AGENT=main
VOICECLAW_NATIVE_AGENT=main

# Optional trusted MCP endpoints for the bundled private Realtime frontend.
# REALTIME_MCP_ALLOWED_SERVER_URLS=["https://mcp.example.com/mcp"]
