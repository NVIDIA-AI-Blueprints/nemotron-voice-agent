# Copy this file to .env at the repository root, or add these entries to an existing .env.
# Set the key that your profile needs.

# Cloud and Server profiles
NVIDIA_API_KEY=

# Single GPU profile
HF_TOKEN=

# Serve the web UI over the internet (optional, for testing). Leave all of these unset for a local deployment: the UI
# then listens on 127.0.0.1 only and has no login. The steps are in SIP.md, "Serve the Web UI over the Internet".
#
# Basic login for the UI, for testing when you need basic authentication. It is not recommended as production
# authentication. If either is set, the page requires a login. Set both: a username without a password locks everyone out.
# LIVEKIT_UI_USERNAME=
# LIVEKIT_UI_PASSWORD=
#
# LiveKit listens on 127.0.0.1 by default. Browsers outside this machine send audio straight to ports 7881 (TCP)
# and 7882 (UDP), so serving the UI over the internet needs 0.0.0.0 here.
# LIVEKIT_BIND=0.0.0.0
#
# The address that LiveKit gives browsers for audio: this host's public IP address, not a name.
# LIVEKIT_NODE_IP=
#
# The LiveKit signaling address that the page uses, when the page is behind an HTTPS proxy that sends /rtc to
# LiveKit, for example wss://voice.example.org. Unset: the page's own host on port 7880.
# LIVEKIT_PUBLIC_WS_URL=
