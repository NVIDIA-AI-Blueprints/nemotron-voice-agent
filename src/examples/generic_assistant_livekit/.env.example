# Environment for the LiveKit generic assistant. Copy it to .env at the repository root, or append these entries
# to an existing .env. The Pipecat examples read the same file and ignore the LIVEKIT_* entries.

# Required for the cloud and server profiles
NVIDIA_API_KEY=

# Required for the single-gpu profile (vLLM and speech weights come from Hugging Face)
# HF_TOKEN=hf_...

# Required: LiveKit credentials shared by the LiveKit server, the agent, and the UI server.
# Generate a secret with: openssl rand -hex 24
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LAN address LiveKit advertises in ICE candidates (default 127.0.0.1, for a browser on the same machine)
# LIVEKIT_NODE_IP=127.0.0.1
# Host address and port for the web UI (default 127.0.0.1:3000)
# LIVEKIT_UI_BIND=127.0.0.1
# LIVEKIT_UI_PORT=3000

# Pick other services from services.yaml (defaults: nemotron-lightning, nemotron-asr-streaming-english,
# magpie-multilingual-tts). The cloud profile accepts only entries with an nvcf key.
# LLM_SERVICE=nemotron-lightning
# ASR_SERVICE=nemotron-asr-streaming-english
# TTS_SERVICE=magpie-multilingual-tts

# Single-gpu profile: speech model directory and TTS threads
# NEMO_SPEECH_MODEL_LOC=/absolute/path/to/nemo-speech-models
# NEMO_SPEECH_TTS_THREADS=8
