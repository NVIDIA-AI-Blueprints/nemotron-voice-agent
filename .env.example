# Required for NVCF cloud services and local NIM containers
NVIDIA_API_KEY=

# Optional host port override for the selector app
# PIPELINE_APP_PORT=7860

# Enable HTTPS with self-signed certs. Set to false to use plain HTTP.
# PIPELINE_TLS=true

# Optional uvicorn worker count for scaling the WebSocket-based pipeline only.
# Do not set this for WebRTC transport.
# UVICORN_WORKERS=1

# Optional Pipecat pipeline idle timeout in seconds.
# Minimum is 300 seconds.
# PIPELINE_IDLE_TIMEOUT_SECS=600

# Cisco Webex BYOVA WebSocket adapter.
# Compose binds the local-test listener to loopback by default. For a Cisco
# deployment, use a public TLS endpoint and set every CISCO_* value below.
# BYOVA_WS_PUBLISH_ADDRESS=127.0.0.1
# BYOVA_WS_PUBLISH_PORT=18086
# Host-native listener port; Compose keeps the container listener on 8086.
# BYOVA_WS_PORT=8086
# BYOVA_TLS_CERT_HOST=/absolute/path/to/tls.crt
# BYOVA_TLS_KEY_HOST=/absolute/path/to/tls.key
# BYOVA_TLS_CERT=/run/secrets/byova-tls.crt
# BYOVA_TLS_KEY=/run/secrets/byova-tls.key
# BYOVA_AUTH_ENABLED=true
# BYOVA_ALLOW_PLAINTEXT_LOCAL=false
# BYOVA_ALLOW_AUTH_DISABLED_LOCAL=false
# CISCO_JWT_ISSUERS=https://idbroker-b-us.webex.com/idb
# CISCO_JWT_AUDIENCE=
# CISCO_JWT_SUBJECT=
# CISCO_JWT_NONCE=
# CISCO_DATASOURCE_URL=wss://byova.example.com
# CISCO_DATASOURCE_SCHEMA_UUID=a38a10b7-43e4-4676-a076-a7d6dce9387d
# CISCO_ORG_UUID=
# CISCO_JWKS_TTL_SECONDS=3600
# CISCO_AUTH_CLOCK_SKEW_SECONDS=30
# BYOVA_VIRTUAL_AGENT_ID=nemotron-generic
# BYOVA_VIRTUAL_AGENT_NAME=Nemotron Generic
# BYOVA_VIRTUAL_AGENT_DESCRIPTION=NVIDIA Nemotron voice agent
# BYOVA_QUEUE_SIZE=128
# BYOVA_SEND_TIMEOUT_SECONDS=5
# BYOVA_FIRST_AUDIO_TIMEOUT_SECONDS=120
# BYOVA_COMPLETION_TIMEOUT_SECONDS=10
# BYOVA_CONTINUATION_GRACE_SECONDS=5
# BYOVA_MAX_MESSAGE_BYTES=1048576

# Optional timeout (seconds) for the pre-connection readiness / TTS warm-up gate
# that runs before a WebRTC/WebSocket session starts.
# CONNECT_PREWARM_TIMEOUT_SECS=45

# Optional word-to-IPA pronunciation dictionary for NvidiaTTSService.
# JSON or YAML file mapping graphemes to IPA phonemes, e.g. {"NVIDIA": "ɛn.vɪ.diː.ʌ"}.
# Relative paths resolve from the repo root.
# TTS_IPA_FILE_PATH=config/ipa.json

# Required for local vLLM recipes (vLLM pulls the model from HF)
# HF_TOKEN=hf_...

# Single-GPU recipes
# Download models: bash scripts/download-nemo-speech-models.sh
# Optional model directory:
# NEMO_SPEECH_MODEL_LOC=/absolute/path/to/nemo-speech-models
# NEMO_SPEECH_TTS_THREADS=8

# Optional vLLM VRAM planner overrides for automatically sized workstation
# Lightning and Omni recipes. Lightning on DGX Spark and Jetson Thor uses 0.35.
# VLLM_VRAM_HEADROOM_MIB=4096
# VLLM_GPU_MEMORY_UTILIZATION=0.75

# Chat history management (initial prompt messages always preserved)
# Keeps the latest N non-prompt messages in the conversation window.
# Defaults to 10 for Generic and Multilingual, and 20 for Frontend/Backend Agent.
# CHAT_HISTORY_RECENT_TURNS=10

# Audio output buffering (WebRTC: 5, WebSocket: 10)
# AUDIO_OUT_10MS_CHUNKS=10

# Default: Pipecat Smart Turn is enabled (Silero VAD stop_secs=0.2, Smart Turn
# silence fallback default 1.0s via SMART_TURN_STOP_SECS). Set
# USE_SILERO_VAD_TURN_DETECTION=true to disable Smart Turn and use pure Silero
# VAD-based end-of-utterance detection instead.
# USE_SILERO_VAD_TURN_DETECTION=false
# SILERO_VAD_STOP_SECS=0.5
# SMART_TURN_STOP_SECS=1.0

# Welcome message: the bot greets/introduces itself as soon as the client
# connects. Configure per example via `welcome_message` in examples_registry.yaml
# (default true). This env var is a GLOBAL override across all examples: when set
# it wins over the registry value (used by the server-perf profile).
# ENABLE_WELCOME_MESSAGE=true

# Audio debugging
# ENABLE_ASR_AUDIO_DUMP=false
# ENABLE_TTS_AUDIO_DUMP=false
# AUDIO_DUMP_PATH=audio_dumps

# OpenTelemetry tracing — see docs/how-to/enable-opentelemetry-tracing.md
# ENABLE_TRACING=false
# OTEL_CONSOLE_EXPORT=false
# OTEL_EXPORTER_OTLP_ENDPOINT=phoenix:4317

# --- Optional TURN server (remote WebRTC NAT/firewall traversal) -----------
# Enable by launching with the 'turn' profile, for example:
#   docker compose --profile generic-assistant/server --profile turn up -d
# Host firewall must allow UDP 3478 and UDP 49160-49200 from clients.
# Defaults to admin:admin if unset. Override in production.
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=admin
# TURN_PASSWORD=admin
